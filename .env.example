# Copy to ".env" and adjust. Only needed on Linux servers; on Windows the .bat files handle everything.

# Address the web page listens on. 127.0.0.1 = only this machine, 0.0.0.0 = whole network.
# The page has no login - only open it to a network you trust.
WEB_BIND=0.0.0.0
WEB_PORT=8080

# Local archive folder on the host (optional; an SMB share is set in the web page instead)
# ARCHIVE_DIR=/srv/music/archive
